# Copia questo file in `.ftp-credentials` (nella root del repo, già escluso
# da git) e inserisci i valori reali. Serve solo in locale, sulla macchina da
# cui esegui `git push` su main: l'hook pre-push lo legge per pubblicare il
# sito su Tophost via FTP.
FTP_HOST='ftp.tuodominio.it'
FTP_USERNAME='tuo-username'
FTP_PASSWORD='tua-password'
FTP_REMOTE_DIR='/htdocs'
